{
  "description": "dryfire: approving a hook for replay, and changing dryfire's settings, stay with you.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/selfguard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
